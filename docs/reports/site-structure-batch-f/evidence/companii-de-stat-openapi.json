    "paths": {
      "/data.json": {
        "get": {
          "summary": "data.json",
          "description": "Dataset agregat care alimenteaza pagina principala: serii de trend 2019-2024, distributii ale marjei nete, scatter salariu-vs-performanta, companii emblematice, statistici sumare, agregari pe judete, scara de salarii.\n\nChei de nivel inalt: `meta`, `trend`, `buckets_2024`, `scatter`, `top_pierdere`, `top_profit`, `emblematice`, `stats`, `dist_2024`, `judete_2024`, `companii_pe_judet`, `pay_scale_rows`.",
          "operationId": "data",
          "responses": {
            "200": {
              "description": "Resursa JSON.",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "additionalProperties": true,
                    "properties": {
                      "meta": {},
                      "trend": {},
                      "buckets_2024": {},
                      "scatter": {},
                      "top_pierdere": {},
                      "top_profit": {},
                      "emblematice": {},
                      "stats": {},
                      "dist_2024": {},
                      "judete_2024": {},
                      "companii_pe_judet": {},
                      "pay_scale_rows": {}
                    }
                  }
                }
              }
            }
          }
        }
      },
      "/companii_search.json": {
        "get": {
          "summary": "companii_search.json",
          "description": "Index slim al tuturor companiilor (CUI, nume, ticker, tier) plus tokenii de cautare. Endpoint de tip lista, pentru enumerare si autocomplete.\n\nChei de nivel inalt: `companii`, `search_tokens`, `meta`.",
          "operationId": "companii_search",
          "responses": {
            "200": {
              "description": "Resursa JSON.",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "additionalProperties": true,
                    "properties": {
                      "companii": {},
                      "search_tokens": {},
                      "meta": {}
                    }
                  }
                }
              }
            }
          }
        }
      },
      "/companii/{cui}.json": {
        "get": {
          "summary": "companii/{cui}.json",
          "description": "Fisa completa per companie. 1.247 fisiere, cheia este codul unic de inregistrare (CUI). Contine istoric financiar, salarii, evaluarea AMEPIP (Anexa 1), bilantul MFin, numarul de angajati, codul CAEN si statusul ONRC.\n\nChei de nivel inalt: `cui`, `nume`, `regnr`, `judet_cod`, `judet_nume`, `sector_key`, `caen`, `ticker`, `listat_bvb`, `status_onrc`, `tier`, `fin_2024`, `fin_history`, `fte`, `salarii`, `anexa1`, `mfin`, `derived_status`.",
          "operationId": "companii_cui",
          "responses": {
            "200": {
              "description": "Resursa JSON.",
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "additionalProperties": true,
                    "properties": {
                      "cui": {},
                      "nume": {},
                      "regnr": {},
                      "judet_cod": {},
                      "judet_nume": {},
                      "sector_key": {},
                      "caen": {},
                      "ticker": {},
                      "listat_bvb": {},
                      "status_onrc": {},
                      "tier": {},
                      "fin_2024": {},
                      "fin_history": {},
                      "fte": {},
                      "salarii": {},
                      "anexa1": {},
                      "mfin": {},
                      "derived_status": {}
                    }
                  }
                }
              }
            },
            "404": {
              "description": "Nu exista o companie cu acest CUI in set."
            }
          },
          "parameters": [
            {
              "name": "cui",
              "in": "path",
              "required": true,
              "schema": {
                "type": "string"
              },
              "description": "Codul unic de inregistrare al companiei, fara prefix RO. Valorile valide sunt cheile din companii_search.json.",
              "example": "14056826"
            }
          ]
        }
      },
