      },
      "linkuri": {
        "kind": "links",
        "required": false
      },
      "subiect_principal": {
        "kind": "concept",
        "scheme": "subiect",
        "min_items": 1,
        "max_items": 1,
        "level": "root",
        "empty_allowed_when": {
          "clasificare_stare": [
            "de-revizuit"
          ]
        }
      },
      "subiecte": {
        "kind": "concept",
        "scheme": "subiect",
        "min_items": 1,
        "max_items": null,
        "level": "root",
        "empty_allowed_when": {
          "clasificare_stare": [
            "de-revizuit"
          ]
        }
      },
      "teme": {
        "kind": "concept",
        "scheme": "subiect",
        "min_items": 0,
        "max_items": null,
        "level": "narrower"
      },
      "scopuri": {
        "kind": "concept",
        "scheme": "scop",
        "min_items": 0,
        "max_items": null
      },
      "functionalitati": {
        "kind": "concept",
        "scheme": "functie",
        "min_items": 0,
        "max_items": null
