{
  "version": "2.0.0-draft.2",
  "status": "editorial_proposal",
  "_doc": "Structural contract. Code values, labels and order live in valori.csv; link roles in roluri-linkuri.csv; host lookup in gazde-linkuri.csv. A field rule names its code list or concept scheme. max_items=null means unbounded. An optional field (required=false, min_items=0) may be empty; absence is never a code row. empty_allowed_when lists the states in which a required field may stay empty (an incomplete classification). private=true keeps a column out of the public site data.",
  "list_separator": "|",
  "lifecycle_status": [
    "propus",
    "acceptat",
    "retras"
  ],
  "authoritative_files": [
    "intrari.csv",
    "concepte.csv",
    "valori.csv",
    "roluri-linkuri.csv",
    "gazde-linkuri.csv",
    "relatii.csv",
    "arii.csv",
    "mapari-externe.csv",
    "revizuire.csv",
    "setari.json"
  ],
  "generated_files": [
    "catalogue.json"
  ],
  "historical_files": [
    "source/*",
    "atribuiri-initiale.csv",
    "corespondente-v1.csv"
  ],
  "settings_keys": [
    "site",
    "nota"
  ],
  "keys": {
    "intrari.csv": [
      "slug"
    ],
    "concepte.csv": [
      "id"
    ],
    "arii.csv": [
      "id"
    ],
