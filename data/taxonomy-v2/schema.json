      },
      "tip_entitate": {
        "kind": "code",
        "list": "tip_entitate",
        "required": true
      },
      "sectiune_url": {
        "kind": "code",
        "list": "sectiune_url",
        "required": true
      },
      "nume": {
        "kind": "text",
        "required": true
      },
      "descriere_scurta": {
        "kind": "text",
        "required": false
      },
      "descriere": {
        "kind": "text",
        "required": false
      },
      "url": {
        "kind": "text",
